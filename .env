# PostgreSQL (use local, Neon, or Supabase)
DATABASE_URL=postgresql://postgres:password@localhost:5432/cassette-web

# NextAuth (for session management)
NEXTAUTH_SECRET=my-secret-key-please-change-in-production-32-chars-min
NEXTAUTH_URL=http://localhost:3000

# yt-dlp binary path (download from https://github.com/yt-dlp/yt-dlp/releases/latest)
YT_DLP_PATH=yt-dlp.exe

# ffmpeg binary path (download from https://ffmpeg.org/download.html)
FFMPEG_PATH=ffmpeg.exe

# Upstash Redis (optional - for rate limiting)
# Leave commented until you have real credentials. Placeholder values are
# truthy, so an uncommented placeholder makes the rate limiter try to reach
# a host that does not exist and fail every search.
# UPSTASH_REDIS_URL=https://your-redis.upstash.io
# UPSTASH_REDIS_TOKEN=your-redis-token

# Cloudflare Turnstile (optional - for CAPTCHA)
# Same caveat as Upstash above: placeholder values are truthy.
# TURNSTILE_SITE_KEY=your-turnstile-site-key
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Node environment
NODE_ENV=development