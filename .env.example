# Database
DATABASE_URL=postgresql://user:password@localhost:5432/cassette-web

# NextAuth
NEXTAUTH_SECRET=your-secret-key-here-must-be-at-least-32-chars
NEXTAUTH_URL=http://localhost:3000

# yt-dlp binary paths
YT_DLP_PATH=yt-dlp.exe
FFMPEG_PATH=ffmpeg.exe

# Upstash Redis for rate limiting. Leave blank or absent unless you have
# real credentials: a placeholder URL is truthy, which makes the limiter
# attempt a connection that fails.
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# Cloudflare Turnstile. Same caveat: blank unless you have real keys.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Node environment
NODE_ENV=development